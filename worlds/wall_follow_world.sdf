<?xml version="1.0" ?>
<!-- 6 x 6 m room for wall following. Outer walls give a full perimeter lap; the partition
     off the west wall adds one inside and one outside corner; the centre block is a second
     wall loop the robot can be spawned next to. Primitive boxes only: no model:// lookups. -->
<sdf version="1.8">
  <world name="wall_follow_world">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="room">
      <static>true</static>
      <link name="walls">
        <collision name="south"><pose>0 -3 0.25 0 0 0</pose><geometry><box><size>6.15 0.15 0.5</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -3 0.25 0 0 0</pose><geometry><box><size>6.15 0.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <collision name="north"><pose>0 3 0.25 0 0 0</pose><geometry><box><size>6.15 0.15 0.5</size></box></geometry></collision>
        <visual name="north_v"><pose>0 3 0.25 0 0 0</pose><geometry><box><size>6.15 0.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <collision name="east"><pose>3 0 0.25 0 0 0</pose><geometry><box><size>0.15 6.15 0.5</size></box></geometry></collision>
        <visual name="east_v"><pose>3 0 0.25 0 0 0</pose><geometry><box><size>0.15 6.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <collision name="west"><pose>-3 0 0.25 0 0 0</pose><geometry><box><size>0.15 6.15 0.5</size></box></geometry></collision>
        <visual name="west_v"><pose>-3 0 0.25 0 0 0</pose><geometry><box><size>0.15 6.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <!-- partition: west wall -> x=-1 at y=1 (inside corner at the wall, outside corner at the tip) -->
        <collision name="partition"><pose>-2 1 0.25 0 0 0</pose><geometry><box><size>2.0 0.15 0.5</size></box></geometry></collision>
        <visual name="partition_v"><pose>-2 1 0.25 0 0 0</pose><geometry><box><size>2.0 0.15 0.5</size></box></geometry>
          <material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material></visual>
        <!-- free-standing block, >=1.2 m from every wall path so the follower never switches to it mid-lap -->
        <collision name="block"><pose>1.2 -0.3 0.25 0 0 0</pose><geometry><box><size>1.0 1.0 0.5</size></box></geometry></collision>
        <visual name="block_v"><pose>1.2 -0.3 0.25 0 0 0</pose><geometry><box><size>1.0 1.0 0.5</size></box></geometry>
          <material><ambient>0.3 0.5 0.7 1</ambient><diffuse>0.3 0.5 0.7 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
